# ==============================================================================
# CONFIGURACIÓN DEL DESPLIEGUE DESATENDIDO DE ARGILLA
# ==============================================================================
# Copie este archivo a '.env' o deje que el script 'install.sh' lo cree
# automáticamente con los valores por defecto.
# ==============================================================================

# --- Versión de Argilla ---
ARGILLA_VERSION=latest

# --- Puerto de acceso Web / REST API ---
# Puerto local expuesto en el host (http://localhost:6900)
ARGILLA_PORT=6900

# --- Credenciales de Administrador y Acceso API ---
ARGILLA_USER=argilla
ARGILLA_PASSWORD=12345678
ARGILLA_API_KEY=argilla.apikey
ARGILLA_WORKSPACE=default

# --- Telemetría de Hugging Face ---
# 1 = Desactivada (recomendado para entornos locales/privados), 0 = Activada
HF_HUB_DISABLE_TELEMETRY=1

# --- Workers en segundo plano ---
# Número de procesos trabajadores para tareas asíncronas y reindexado
BACKGROUND_NUM_WORKERS=2

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=argilla

# --- Motor de Búsqueda Elasticsearch ---
# Asignación de memoria RAM para la JVM de Elasticsearch (-Xms y -Xmx).
# 512m es suficiente para desarrollo/pruebas.
# Para datasets grandes o producción, aumentar a 1g o 2g.
ES_HEAP_SIZE=512m

# Opciones adicionales de JVM para Elasticsearch.
# El instalador configurará automáticamente '-XX:UseSVE=0' en macOS con Apple Silicon (arm64).
# En Windows o procesadores x86_64 debe quedar vacío para evitar fallos de inicialización de la JVM.
ES_JAVA_OPTS_EXTRA=

