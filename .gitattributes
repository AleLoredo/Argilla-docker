# Normalizar finales de línea (evitar problemas de CRLF en Windows para scripts bash y configs)
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.env text eol=lf
*.env.example text eol=lf
Makefile text eol=lf
